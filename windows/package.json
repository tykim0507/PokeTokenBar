{
  "name": "poketokenbar-windows",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows tray companion that grows from local AI coding usage",
  "author": "tykim0507",
  "license": "MIT",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "format": "prettier --write src test e2e scripts *.json *.ts README.md",
    "format:check": "prettier --check src test e2e scripts *.json *.ts README.md"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "io.github.tykim0507.poketokenbar.windows",
    "productName": "PokeTokenBar Windows",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/src/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PokeTokenBar-Windows-${version}-${arch}-nsis.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "PokeTokenBar-Windows-${version}-${arch}-portable.${ext}"
    }
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
